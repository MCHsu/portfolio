---
import { Download } from "lucide-react";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import { Button } from "@/components/ui/button";
import { NAV_SECTIONS } from "@/lib/sections";
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60"
>
  <div class="shell flex h-14 sm:h-16 w-full items-center justify-between">
    <div class="flex flex-1 justify-start">
      <a class="flex items-center space-x-2" href="/" aria-label="MINCHIA Logo">
        <span
          aria-hidden="true"
          class="inline-block h-5 aspect-[136/24] bg-muted-foreground hover:bg-foreground transition-colors mask-[url(/images/logo.svg)] mask-contain mask-center mask-no-repeat md:h-6"
        ></span>
      </a>
    </div>

    <nav
      class="hidden items-center justify-center gap-8 lg:gap-12 text-base font-medium md:flex md:flex-1 lg:text-lg"
    >
      {
        NAV_SECTIONS.map((section) => (
          <a
            class="text-muted-foreground transition-colors hover:text-foreground dark:text-white/70 dark:hover:text-white"
            href={`/#${section.id}`}
          >
            {section.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-1 items-center justify-end gap-2 md:gap-3 lg:gap-4">
      <a
        href="https://drive.google.com/file/d/1zcMcsnZF3VfaxHIntIukflIVUQxr8cC9/view?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Button variant="outline" size="lg">
          <Download />
          Resume
        </Button>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
