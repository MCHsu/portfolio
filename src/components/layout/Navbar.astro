---
import { Download } from "lucide-react";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import { Button } from "@/components/ui/button";
import { NavLinks } from "@/components/layout/NavLinks";
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60"
>
  <div class="shell flex h-14 w-full items-center justify-between sm:h-16">
    <div class="flex flex-1 justify-start">
      <a class="flex items-center space-x-2" href="/" aria-label="MINCHIA Logo">
        <span
          aria-hidden="true"
          class="inline-block aspect-[136/24] h-5 bg-muted-foreground mask-[url(/images/logo.svg)] mask-contain mask-center mask-no-repeat transition-colors hover:bg-foreground md:h-6"
        ></span>
      </a>
    </div>

    <nav
      class="hidden items-center justify-center gap-8 text-base font-medium md:flex md:flex-1 lg:gap-12 lg:text-lg"
    >
      <NavLinks variant="desktop" client:idle />
    </nav>

    <div class="flex flex-1 items-center justify-end gap-2 md:gap-3 lg:gap-4">
      <a
        href="https://drive.google.com/file/d/1zcMcsnZF3VfaxHIntIukflIVUQxr8cC9/view?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Button variant="outline" size="lg">
          <Download />
          Resume
        </Button>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
