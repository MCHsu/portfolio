---
import { Blocks, Handshake, Sparkles, Sprout } from "lucide-react";
import BringCard from "@/components/sections/BringCard.astro";
import SectionTitle from "@/components/sections/SectionTitle.astro";

const bringItems = [
  {
    icon: Sparkles,
    title: "Product Mindset",
    description: "Building with users, business, and long-term value in mind.",
  },
  {
    icon: Blocks,
    title: "Scalable Code",
    description: "Building systems that are easy to maintain and grow.",
  },
  {
    icon: Handshake,
    title: "Collaboration",
    description: "Bridging design, product, and engineering teams.",
  },
  {
    icon: Sprout,
    title: "Continuous Growth",
    description:
      "Always learning new technologies and improving building skills.",
  },
];
---

<section
  id="about"
  class="relative w-full bg-transparent py-16 md:py-24 lg:py-28"
>
  <SectionTitle title="About me" />

  <div
    class="mx-auto w-full max-w-4xl rounded-[20px] border border-card-border bg-card p-6 pt-16 text-card-foreground shadow-2xs md:rounded-3xl md:p-12 md:pt-24 lg:p-16 lg:py-24"
  >
    <div
      class="mb-8 flex flex-col items-center justify-center gap-8 md:mb-16 md:flex-row md:gap-16 lg:gap-20"
    >
      <img
        src="/images/portrait.svg"
        alt="About character"
        class="h-auto w-28 shrink-0 md:w-32 lg:w-40"
      />

      <div class="flex items-center gap-8 md:gap-12">
        <div class="text-center md:text-left">
          <div
            class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground md:text-5xl"
          >
            2.5 <span class="text-xl font-bold md:text-2xl">yrs</span>
          </div>
          <div
            class="mt-1 text-sm font-semibold text-muted-foreground md:text-xl"
          >
            Frontend
          </div>
        </div>
        <div class="h-12 w-px bg-border"></div>
        <div class="text-center md:text-left">
          <div
            class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground md:text-5xl"
          >
            2 <span class="text-xl font-bold md:text-2xl">yrs</span>
          </div>
          <div
            class="mt-1 text-sm font-semibold text-muted-foreground md:text-xl"
          >
            UI/UX
          </div>
        </div>
      </div>
    </div>

    <p
      class="mb-8 text-left text-base text-muted-foreground md:mb-16 md:text-lg"
    >
      I am a passionate software engineer focused on modern frontend
      technologies and user experience design. I believe that excellent code not
      only solves problems but also brings elegant visual enjoyment and smooth
      operation experience.
    </p>

    <div>
      <h3 class="mb-6 text-left text-xl font-bold text-foreground md:text-2xl">
        What I bring
      </h3>

      <div class="flex w-full flex-wrap gap-3 md:gap-4">
        {
          bringItems.map((item) => (
            <BringCard
              icon={item.icon}
              title={item.title}
              description={item.description}
            />
          ))
        }
      </div>
    </div>

