---
import { Button } from "@/components/ui/button";
import SectionTitle from "@/components/sections/SectionTitle.astro";

interface Props {
  title?: string;
  description?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  title = "Get In Touch",
  description = "Feel free to reach out if you're looking for a developer, have a question, or simply want to connect.",
  buttonLabel = "Contact me",
  buttonHref = "mailto:hello@min.dev",
} = Astro.props;
---

<section
  id="contact"
  class="relative isolate w-full py-16 md:py-24 lg:mb-44 lg:py-28"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-[55%] md:top-[65%] left-1/2 z-0 aspect-3/4 sm:aspect-3/4 md:aspect-1092/810 w-[180%] max-w-none -translate-x-1/2 -translate-y-1/2 select-none sm:w-[140%] md:w-[120%] lg:w-full dark:opacity-30"
  >
    <div
      class="absolute inset-0 bg-radial-[38.69%_38.69%_at_63%_49%] from-glow-warm to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 bg-radial-[38.69%_38.69%_at_37%_50%] from-glow-pink to-transparent"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center px-6 text-center"
  >
    <SectionTitle title={title} />

    <div
      class="flex flex-col items-center justify-center mx-auto w-full max-w-4xl gap-10 px-4 pt-8"
    >
      <img
        src="/images/contact-illustration.svg"
        alt=""
        class="pointer-events-none w-48 select-none sm:w-56 md:w-64 lg:w-80"
      />

      <p
        class="max-w-sm text-base font-medium text-muted-foreground md:max-w-lg md:text-lg"
      >
        {description}
      </p>

      <a href={buttonHref}>
        <Button>{buttonLabel}</Button>
      </a>
    </div>
  </div>
</section>
