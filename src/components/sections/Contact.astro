---
import { Button } from "@/components/ui/button";
import SectionTitle from "@/components/sections/SectionTitle.astro";

interface Props {
  title?: string;
  description?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  title = "Get In Touch",
  description = "Feel free to reach out if you're looking for a developer, have a question, or simply want to connect.",
  buttonLabel = "Contact me",
  buttonHref = "mailto:hello@min.dev",
} = Astro.props;
---

<section
  id="contact"
  class="relative isolate left-1/2 w-screen max-w-[100vw] -translate-x-1/2 py-16 md:py-24 lg:mb-44 lg:py-28"
>
  <img
    src="/images/contact_bg.svg"
    alt=""
    class="pointer-events-none absolute top-[65%] left-1/2 z-0 w-[180%] max-w-none -translate-x-1/2 -translate-y-1/2 select-none sm:w-[140%] md:w-[120%] lg:w-[1200px] dark:opacity-30"
  />

  <div
    class="relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center px-6 text-center"
  >
    <SectionTitle title={title} className="mb-8 md:mb-12" />

    <div
      class="flex flex-col items-center justify-center mx-auto w-full max-w-4xl gap-10 px-4 pt-8"
    >
      <img
        src="/images/contact-illustration.svg"
        alt=""
        class="pointer-events-none w-48 select-none sm:w-56 md:w-64 lg:w-80"
      />

      <p
        class="max-w-sm text-base leading-relaxed text-muted-foreground md:max-w-lg md:text-lg"
      >
        {description}
      </p>

      <a href={buttonHref}>
        <Button>{buttonLabel}</Button>
      </a>
    </div>
  </div>
</section>
