---
import { Button } from "@/components/ui/button";
import SectionTitle from "@/components/sections/SectionTitle.astro";

interface Props {
  title?: string;
  description?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  title = "Get In Touch",
  description = "Feel free to reach out if you're looking for a developer, have a question, or simply want to connect.",
  buttonLabel = "Contact me",
  buttonHref = "mailto:a860610@gmail.com",
} = Astro.props;
---

<section
  id="contact"
  class="relative isolate shell w-full py-16 md:py-24 lg:mb-44 lg:py-28"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-[-20%] top-0 -bottom-32 z-0 select-none sm:inset-x-[-10%] md:top-[5%] lg:inset-x-0"
  >
    <div
      class="absolute inset-0 bg-radial-[38.69%_38.69%_at_63%_49%] from-glow-warm via-glow-warm/80 to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 bg-radial-[38.69%_38.69%_at_37%_50%] from-glow-pink via-glow-pink/80 to-transparent"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center px-6 text-center"
  >
    <SectionTitle title={title} />

    <div
      class="mx-auto flex w-full max-w-4xl flex-col items-center justify-center gap-10 pt-8 md:px-4"
    >
      <img
        src="/images/contact-illustration.svg"
        alt=""
        class="pointer-events-none h-auto w-52 select-none sm:w-60 md:w-70 lg:w-84"
      />

      <p
        class="max-w-sm text-base font-medium text-muted-foreground md:max-w-lg md:text-lg"
      >
        {description}
      </p>

      <a href={buttonHref}>
        <Button>{buttonLabel}</Button>
      </a>
    </div>
  </div>
</section>
