---
interface Props {
  title: string;
  subtitle?: string;
  className?: string;
}

const { title, subtitle, className = "" } = Astro.props;
---

<div class={`flex flex-col items-center gap-3 text-center md:gap-4 ${className}`}>
  <h2 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl md:text-5xl">
    {title}
  </h2>
  {
    subtitle && (
      <p class="max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg lg:text-2xl">
        {subtitle}
      </p>
    )
  }
</div>
