---
import { Button } from "@/components/ui/button";
---

<section
  id="hero"
  class="relative left-1/2 z-0 flex min-h-[calc(100svh-4rem)] w-screen max-w-[100vw] -translate-x-1/2 flex-col items-center justify-center py-16 md:py-20"
>
  <img
    src="/images/star-white.svg"
    alt=""
    class="pointer-events-none absolute top-[28%] left-[6%] z-20 w-5 select-none animate-star-flicker-slow sm:left-[10%] sm:w-6 md:left-[14%] md:w-8 lg:left-[18%]"
  />
  <img
    src="/images/star-white.svg"
    alt=""
    class="pointer-events-none absolute top-[36%] right-[6%] z-20 w-4 select-none animate-star-flicker sm:right-[10%] sm:w-5 md:right-[14%] md:w-7 lg:right-[18%]"
  />

  <div
    class="relative z-30 mx-auto flex w-full flex-col items-center px-6 text-center sm:px-8 md:gap-6"
  >
    <h1
      class="text-[28px] leading-tight font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl md:leading-[1.1]"
    >
      <span class="block mb-2 md:mb-4">Hi, I’m MIN CHIA</span>
      <span class="block">Frontend Engineer</span>
    </h1>
    <p
      class="max-w-sm md:max-w-xl mx-auto mt-6 text-base font-medium text-muted-foreground sm:text-lg md:mt-8 md:text-xl"
    >
      I am a passionate software engineer focused on modern frontend
      technologies and user experience design.
    </p>

    <div class="mt-8 flex w-full justify-center md:mt-10">
      <a href="#projects">
        <Button> View my work </Button>
      </a>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 left-1/2 z-10 aspect-3/4 md:aspect-4/3 w-[180%] max-w-none -translate-x-1/2 -translate-y-1/2 select-none sm:w-[140%] md:w-[120%] lg:w-full dark:opacity-30"
  >
    <div
      class="absolute inset-0 bg-radial-[35%_50%_at_35%_50%] from-glow-warm to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 bg-radial-[35%_50%_at_65%_50%] from-glow-pink to-transparent"
    >
    </div>
  </div>
</section>
