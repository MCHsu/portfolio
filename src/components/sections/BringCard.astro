---
import type { LucideIcon } from "lucide-react";

interface Props {
  icon: LucideIcon;
  title: string;
  description: string;
}

const { icon: Icon, title, description } = Astro.props;
---

<div
  class="flex flex-1 basis-full items-start gap-3 rounded-xl border border-card-border bg-card p-4 lg:basis-[calc(50%-0.5rem)] lg:gap-4 lg:p-5"
>
  <Icon className="mt-0.5 size-5 shrink-0 text-foreground" />
  <div class="min-w-0">
    <h4 class="text-left text-lg font-bold text-foreground md:text-xl">
      {title}
    </h4>
    <p class="mt-1 text-sm text-muted-foreground md:text-base">{description}</p>
  </div>
</div>
