---
import Layout from "@/layouts/Layout.astro";
import { render } from "astro:content";
import { Button } from "@/components/ui/button";
import { getSortedProjects } from "@/lib/projects";

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} | Portfolio`}>
  <article class="max-w-4xl mx-auto py-24 px-6 w-full relative z-10">
    <div class="mb-12">
      <a
        href="/#projects"
        class="text-accent hover:text-accent/80 flex items-center gap-2 mb-8 transition-colors w-fit"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-arrow-left"
          ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg
        >
        Back to Projects
      </a>

      <h1
        class="text-4xl md:text-6xl font-black text-foreground mb-6 uppercase tracking-wider"
      >
        {project.data.title}
      </h1>
      <p class="text-xl text-muted-foreground mb-8 leading-relaxed max-w-3xl">
        {project.data.description}
      </p>

      <div class="flex flex-wrap gap-3 mb-8">
        {
          project.data.tags.map((tag) => (
            <span class="px-3 py-1.5 text-sm rounded-md border border-project-card-border bg-card/30 text-muted-foreground font-medium">
              {tag}
            </span>
          ))
        }
      </div>

      <div class="flex gap-4">
        {
          project.data.demoUrl && (
            <a
              href={project.data.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Button className="bg-accent hover:bg-accent/80 text-accent-foreground font-bold">
                Demo
              </Button>
            </a>
          )
        }
        {
          project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Button variant="outline" className="rounded-lg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mr-2"
                >
                  <>
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </>
                </svg>
                Source Code
              </Button>
            </a>
          )
        }
      </div>
    </div>

    {/* Project Content Box */}
    <div
      class="prose prose-invert prose-accent max-w-none rounded-2xl bg-card/30 border border-border p-8 md:p-12 backdrop-blur-sm shadow-2xl"
    >
      <Content />
    </div>
  </article>
</Layout>
